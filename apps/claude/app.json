{
  "configVersion": "v3",
  "app": {
    "appId": 1092603,
    "appName": "Claude",
    "appType": "app",
    "version": {
      "code": 12,
      "name": "0.3.1"
    },
    "icon": "claude-icon.png",
    "vender": "Fikra Labs",
    "description": "Claude Code в проектах на Mac с часов"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.mic",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.6.0",
      "target": "3.6.0",
      "minVersion": "3.6"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/voice",
            "page/history"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 390
        }
      ],
      "designWidth": 390
    }
  },
  "i18n": {
    "ru-RU": {
      "appName": "Claude"
    },
    "en-US": {
      "appName": "Claude"
    }
  },
  "defaultLanguage": "ru-RU"
}
